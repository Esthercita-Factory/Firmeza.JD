<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firmeza</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Orbitron:wght@600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/firmeza-theme.css" asp-append-version="true" />
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="container-fluid p-0">
        <div class="d-flex flex-nowrap">
            
            <!-- Sidebar -->
            <div class="sidebar d-none d-md-block" style="width: 250px; flex-shrink: 0;">
                <div class="position-sticky top-0">
                    <a href="@Url.Action("Index", "Home")" class="brand text-center">
                        <i class="bi bi-box-seam me-2 text-primary"></i>Firmeza
                    </a>
                    
                    <div class="mt-4 mb-2 px-4 text-uppercase fw-bold text-muted" style="font-size: 0.75rem; letter-spacing: 0.05em;">Principal</div>
                    
                    <ul class="nav flex-column mb-auto">
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Home")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                                <span class="sidebar-icon"><i class="bi bi-pie-chart"></i></span> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Products")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")">
                                <span class="sidebar-icon"><i class="bi bi-box"></i></span> Productos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Customers")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Customers" ? "active" : "")">
                                <span class="sidebar-icon"><i class="bi bi-people"></i></span> Clientes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Sales")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Sales" ? "active" : "")">
                                <span class="sidebar-icon"><i class="bi bi-cart"></i></span> Ventas
                            </a>
                        </li>
                    </ul>
                    
                    <hr class="mx-3 border-secondary">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                <button type="submit" class="btn btn-link nav-link w-100 text-start" style="color: var(--fz-sidebar-text);">
                                    <span class="sidebar-icon"><i class="bi bi-box-arrow-right"></i></span> Cerrar Sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Mobile Offcanvas Sidebar -->
            <div class="offcanvas offcanvas-start sidebar" tabindex="-1" id="sidebarMobile" aria-labelledby="sidebarMobileLabel" style="width: 250px;">
                <div class="offcanvas-header border-bottom border-secondary">
                    <h5 class="offcanvas-title text-white" id="sidebarMobileLabel"><i class="bi bi-box-seam me-2 text-primary"></i>Firmeza</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body p-0 pt-3">
                    <ul class="nav flex-column mb-auto">
                        <li class="nav-item"><a href="@Url.Action("Index", "Home")" class="nav-link"><span class="sidebar-icon"><i class="bi bi-pie-chart"></i></span> Dashboard</a></li>
                        <li class="nav-item"><a href="@Url.Action("Index", "Products")" class="nav-link"><span class="sidebar-icon"><i class="bi bi-box"></i></span> Productos</a></li>
                        <li class="nav-item"><a href="@Url.Action("Index", "Customers")" class="nav-link"><span class="sidebar-icon"><i class="bi bi-people"></i></span> Clientes</a></li>
                        <li class="nav-item"><a href="@Url.Action("Index", "Sales")" class="nav-link"><span class="sidebar-icon"><i class="bi bi-cart"></i></span> Ventas</a></li>
                    </ul>
                    <hr class="mx-3 border-secondary">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                        <button type="submit" class="btn btn-link nav-link w-100 text-start" style="color: var(--fz-sidebar-text);"><span class="sidebar-icon"><i class="bi bi-box-arrow-right"></i></span> Cerrar Sesión</button>
                    </form>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="flex-grow-1" style="min-width: 0;">
                <!-- Topbar -->
                <header class="topbar d-flex align-items-center justify-content-between position-sticky top-0">
                    <div class="d-flex align-items-center flex-grow-1">
                        <button class="btn btn-link text-muted d-md-none me-2 p-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMobile">
                            <i class="bi bi-list fs-3"></i>
                        </button>
                        
                        <!-- Search Box -->
                        <div class="position-relative d-none d-sm-block" style="max-width: 400px; width: 100%;">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" class="form-control search-input" placeholder="Buscar en Firmeza...">
                        </div>
                    </div>
                    
                    <!-- User & Notifications -->
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-link text-muted position-relative p-0">
                            <i class="bi bi-bell fs-5"></i>
                            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                <span class="visually-hidden">New alerts</span>
                            </span>
                        </button>
                        
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                    <span>A</span>
                                </div>
                                <span class="d-none d-md-block text-dark fw-medium">Administrador</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="dropdownUser">
                                <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i> Perfil</a></li>
                                <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i> Configuración</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Content -->
                <main class="main-content">
                    <!-- Breadcrumbs & Header -->
                    <div class="d-flex justify-content-between align-items-end mb-4">
                        <div>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-1">
                                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted">Firmeza</a></li>
                                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                                </ol>
                            </nav>
                            <h2 class="h3 mb-0 fw-bold">@ViewData["Title"]</h2>
                        </div>
                        @RenderSection("HeaderActions", required: false)
                    </div>

                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
