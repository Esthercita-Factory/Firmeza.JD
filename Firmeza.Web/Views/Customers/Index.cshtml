@model IEnumerable<Firmeza.Domain.Entities.Customer>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Directorio de Clientes";
}

@section HeaderActions {
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Nuevo Cliente</a>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0 text-dark">Cartera Activa</h6>
        <form asp-action="Index" method="get" class="d-flex">
            <div class="input-group input-group-sm">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Buscar por documento o nombre..." />
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Cliente</th>
                        <th>Contacto</th>
                        <th>Documento</th>
                        <th>Edad</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if(!Model.Any()) {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No se encontraron clientes.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px; font-weight: 600;">
                                        @(string.IsNullOrEmpty(item.Name) ? "?" : item.Name.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-medium text-dark">@item.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-envelope text-muted me-1"></i> @(item.Email ?? "No registrado")</div>
                                <div class="small"><i class="bi bi-telephone text-muted me-1"></i> @(item.Phone ?? "No registrado")</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@item.Document</span></td>
                            <td>@item.Age años</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary me-1"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
