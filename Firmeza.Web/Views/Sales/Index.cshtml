@model IEnumerable<Firmeza.Domain.Entities.Sale>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Historial de Ventas";
}

@section HeaderActions {
    <div>
        <button class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-filter"></i> Filtrar</button>
        <button class="btn btn-primary btn-sm"><i class="bi bi-cart-plus me-1"></i> Registrar Venta</button>
    </div>
}

<div class="card">
    <div class="card-header border-bottom">
        <h6 class="mb-0 text-dark">Todas las Ventas</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID Venta</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if(!Model.Any()) {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay ventas registradas.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="fw-medium text-primary">#@item.Id.ToString("D5")</span></td>
                            <td>
                                <div class="text-dark">@item.Date.ToShortDateString()</div>
                                <div class="small text-muted">@item.Date.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-person-circle text-muted me-2 fs-5"></i>
                                    <span class="fw-medium text-dark">@item.Customer.Name</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-soft-success rounded-pill"><i class="bi bi-check-circle me-1"></i>Completado</span>
                            </td>
                            <td class="text-end fw-bold text-dark">$@item.TotalAmount.ToString("N2")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-light text-primary" data-bs-toggle="tooltip" title="Ver Detalles"><i class="bi bi-eye"></i></button>
                                <button class="btn btn-sm btn-light text-secondary" data-bs-toggle="tooltip" title="Descargar Factura"><i class="bi bi-download"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
