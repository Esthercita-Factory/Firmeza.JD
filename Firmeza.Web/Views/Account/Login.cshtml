@model Firmeza.Web.ViewModels.LoginViewModel
@{
    Layout = null; // No admin layout for login
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Firmeza</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center py-4" style="height: 100vh;">
    <main class="w-100 m-auto" style="max-width: 400px;">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3 fw-normal text-center">Firmeza Admin</h1>
                <form asp-controller="Account" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" id="floatingInput" placeholder="name@example.com">
                        <label for="floatingInput">Correo electrónico</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" id="floatingPassword" placeholder="Contraseña">
                        <label for="floatingPassword">Contraseña</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <button class="w-100 btn btn-lg btn-primary" type="submit">Iniciar sesión</button>
                    
                    <div class="mt-3 text-center">
                        <a href="@Url.Action("Register", "Account")">Registrar nuevo usuario</a>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
