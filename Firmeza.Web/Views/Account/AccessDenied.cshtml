@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso Denegado - Firmeza</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center py-4" style="height: 100vh;">
    <main class="w-100 m-auto text-center" style="max-width: 500px;">
        <h1 class="text-danger display-4"><i class="bi bi-shield-lock"></i></h1>
        <h2 class="mb-3">Acceso Denegado</h2>
        <p class="lead">No tiene los permisos necesarios para acceder a esta página.</p>
        <p>Si usted es cliente, por favor utilice la aplicación cliente designada (Blazor, React, Angular, etc.).</p>
        <a href="@Url.Action("Login", "Account")" class="btn btn-primary mt-3">Volver al inicio de sesión</a>
    </main>
</body>
</html>
